{
  "name": "mythic-dnd-hub",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "神话 DND 游戏集合与本机作者工作台",
  "engines": { "node": ">=24" },
  "scripts": {
    "start": "node server.mjs",
    "manage": "node manager.mjs",
    "serve": "node server.mjs --public-only",
    "precheck": "node scripts/prepare-render.mjs",
    "check": "node scripts/check-source.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:mcp": "npm --prefix server/mcp test",
    "build:render": "npm ci --omit=dev --prefix server/mcp && npm run check"
  }
}
